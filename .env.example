# Leave the API base URL on the Vite development proxy for local development.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:8000
POSTGRES_PASSWORD=change-me-locally
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
STAFF_SESSION_COOKIE_NAME=obia_staff_session
STAFF_CSRF_COOKIE_NAME=obia_staff_csrf
STAFF_SESSION_TTL_HOURS=8
STAFF_AUTH_RATE_LIMIT=5
# Generate a private Fernet key; required before staff invitations or owner bootstrap.
STAFF_MFA_ENCRYPTION_KEY=
# Customer email OTP auth (backend). Never expose these to Vite/React.
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_APP_URL=http://localhost:5173
OTP_HASH_SECRET=replace-with-a-long-random-secret
ENVIRONMENT=development
