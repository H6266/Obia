# Local development only. Replace these values with managed secrets in deployed environments.
DATABASE_URL=postgresql+psycopg://falaaa:falaaa-local-only@localhost:5432/falaaa
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SESSION_COOKIE_NAME=falaaa_session
CSRF_COOKIE_NAME=falaaa_csrf
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
STAFF_SESSION_COOKIE_NAME=falaaa_staff_session
STAFF_CSRF_COOKIE_NAME=falaaa_staff_csrf
STAFF_SESSION_TTL_HOURS=8
STAFF_AUTH_RATE_LIMIT=5
# Generate a private Fernet key; required before staff invitations or owner bootstrap.
STAFF_MFA_ENCRYPTION_KEY=
ENVIRONMENT=development
